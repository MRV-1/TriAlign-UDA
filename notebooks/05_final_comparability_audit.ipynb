    "\n",
    "# ============================================================\n",
    "# 2) Protocol identity checks\n",
    "# ============================================================\n",
    "def sha256_array(a):\n",
    "    a = np.ascontiguousarray(a)\n",
    "    return hashlib.sha256(a.view(np.uint8)).hexdigest()\n",
    "\n",
    "def load_idx(run_dir, filename):\n",
    "    p = os.path.join(run_dir, \"config\", filename)\n",
    "    assert os.path.exists(p), p\n",
    "    return np.load(p)\n",
    "\n",
    "idx_files = [\n",
    "    \"nct_source_train_indices_seed42.npy\",\n",
    "    \"nct_source_val_indices_seed42.npy\",\n",
    "    \"tcga_indices_seed42_n10000.npy\",\n",
    "]\n",
    "\n",
    "protocol_rows = []\n",
    "\n",
    "for filename in idx_files:\n",
    "    tri = load_idx(TRIALIGN_RUN, filename)\n",
    "    euda = load_idx(EUDA_RUN, filename)\n",
    "    plada = load_idx(PLADA_RUN, filename)\n",
    "\n",
    "    row = {\n",
    "        \"array\": filename,\n",
    "        \"n\": len(tri),\n",
    "        \"TriAlign_sha256\": sha256_array(tri.astype(np.int64)),\n",
    "        \"EUDA_sha256\": sha256_array(euda.astype(np.int64)),\n",
    "        \"PLADA_sha256\": sha256_array(plada.astype(np.int64)),\n",
    "        \"TriAlign_equals_EUDA\": bool(np.array_equal(tri, euda)),\n",
    "        \"TriAlign_equals_PLADA\": bool(np.array_equal(tri, plada)),\n",
    "    }\n",
    "    protocol_rows.append(row)\n",
    "\n",
    "protocol_df = pd.DataFrame(protocol_rows)\n",
    "\n",
    "display(protocol_df)\n",
    "\n",
    "assert protocol_df[\"TriAlign_equals_EUDA\"].all(), \"EUDA indices differ from TriAlign.\"\n",
    "assert protocol_df[\"TriAlign_equals_PLADA\"].all(), \"PLADA indices differ from TriAlign.\"\n",
    "\n",
    "# Feature-bank shapes\n",
    "Xs = np.load(NCT_X_PATH, mmap_mode=\"r\")\n",
    "ys = np.load(NCT_Y_PATH)\n",
    "Xcrc = np.load(CRC_X_PATH, mmap_mode=\"r\")\n",
    "ycrc = np.load(CRC_Y_PATH)\n",
    "Xt = np.load(TCGA_X_PATH, mmap_mode=\"r\")\n",
    "\n",
    "shape_df = pd.DataFrame([\n",
    "    {\"dataset\": \"NCT\", \"shape\": str(tuple(Xs.shape)), \"labels\": len(ys)},\n",
    "    {\"dataset\": \"CRC7K\", \"shape\": str(tuple(Xcrc.shape)), \"labels\": len(ycrc)},\n",
    "    {\"dataset\": \"TCGA\", \"shape\": str(tuple(Xt.shape)), \"labels\": \"UNUSED/UNLABELED\"},\n",
    "])\n",
    "\n",
    "display(shape_df)\n",
    "\n",
    "assert tuple(Xs.shape) == (100000, 1536)\n",
    "assert tuple(Xcrc.shape) == (7180, 1536)\n",
    "assert len(ycrc) == 7180\n",
    "\n",
    "protocol_df.to_csv(\n",
    "    os.path.join(AUDIT_DIR, \"AUDIT_protocol_identity.csv\"),\n",
    "    index=False\n",
    ")\n",
    "\n",
    "print(\"✓ Exact source/target index identity confirmed.\")\n",
    "print(\"✓ Same frozen 1536-D UNI2-H input feature banks confirmed.\")\n"
   ]
