    "\n",
    "# ============================================================\n",
    "# 4) Exact model definitions required only for checkpoint loading\n",
    "# ============================================================\n",
    "\n",
    "# ---------------- TriAlign ----------------\n",
    "class TriAlignAdapter(nn.Module):\n",
    "    def __init__(self, dim=1536, reduction=16):\n",
    "        super().__init__()\n",
    "        h = max(dim // reduction, 64)\n",
    "\n",
    "        self.net = nn.Sequential(\n",
    "            nn.LayerNorm(dim),\n",
    "            nn.Linear(dim, h),\n",
    "            nn.GELU(),\n",
    "            nn.Linear(h, dim),\n",
    "        )\n",
    "\n",
    "    def forward(self, x):\n",
    "        return x + self.net(x)\n",
    "\n",
    "\n",
    "class TriAlignHead(nn.Module):\n",
    "    def __init__(self, dim=1536, num_classes=9):\n",
    "        super().__init__()\n",
    "        self.fc = nn.Linear(dim, num_classes)\n",
    "\n",
    "    def forward(self, x):\n",
    "        return self.fc(x)\n",
    "\n",
    "\n",
    "# ---------------- EUDA ----------------\n",
    "class EUDASmall(nn.Module):\n",
    "    def __init__(self, input_dim=1536, bottleneck_dim=256, num_classes=9):\n",
    "        super().__init__()\n",
    "        self.bottleneck = nn.Linear(input_dim, bottleneck_dim)\n",
    "        self.head = nn.Linear(bottleneck_dim, num_classes)\n",
    "\n",
    "    def features(self, x):\n",
    "        return self.bottleneck(x)\n",
    "\n",
    "    def logits_from_features(self, z):\n",
    "        return self.head(z)\n",
    "\n",
    "\n",
    "# ---------------- PLADA-v3 ----------------\n",
    "class ResidualFeatureGenerator(nn.Module):\n",
    "    def __init__(self, dim=1536, reduction=16):\n",
    "        super().__init__()\n",
    "        hidden = max(dim // reduction, 64)\n",
    "\n",
    "        self.norm = nn.LayerNorm(dim)\n",
    "        self.fc1 = nn.Linear(dim, hidden)\n",
    "        self.fc2 = nn.Linear(hidden, dim)\n",
    "\n",
    "        nn.init.zeros_(self.fc2.weight)\n",
    "        nn.init.zeros_(self.fc2.bias)\n",
    "\n",
    "    def forward(self, x):\n",
    "        delta = self.fc2(\n",
    "            F.gelu(\n",
    "                self.fc1(\n",
    "                    self.norm(x)\n",
    "                )\n",
    "            )\n",
    "        )\n",
    "        return x + delta\n",
    "\n",
    "\n",
    "class PrototypeLayer(nn.Module):\n",
    "    def __init__(self, num_classes=9, dim=1536):\n",
    "        super().__init__()\n",
    "        self.prototypes = nn.Parameter(\n",
    "            torch.empty(num_classes, dim)\n",
    "        )\n",
    "        nn.init.normal_(\n",
    "            self.prototypes,\n",
    "            mean=0.0,\n",
    "            std=0.02\n",
    "        )\n",
    "\n",
    "    def forward(self, z):\n",
    "        zn = F.normalize(z, dim=1)\n",
    "        pn = F.normalize(self.prototypes, dim=1)\n",
    "\n",
    "        similarity = zn.matmul(pn.t())\n",
    "        distance_sq = (\n",
    "            2.0 - 2.0 * similarity\n",
    "        ).clamp_min(0.0)\n",
    "\n",
    "        return similarity, distance_sq\n",
    "\n",
    "\n",
    "class PrototypeClassifier(nn.Module):\n",
    "    def __init__(self, num_classes=9, scale_init=10.0):\n",
    "        super().__init__()\n",
    "\n",
    "        self.classifier = nn.Linear(\n",
    "            num_classes,\n",
    "            num_classes\n",
    "        )\n",
    "\n",
    "        with torch.no_grad():\n",
    "            self.classifier.weight.zero_()\n",
    "            self.classifier.bias.zero_()\n",
    "            self.classifier.weight.copy_(\n",
    "                torch.eye(num_classes)\n",
    "            )\n",
    "\n",
    "        self.log_scale = nn.Parameter(\n",
    "            torch.tensor(\n",
    "                math.log(scale_init),\n",
    "                dtype=torch.float32\n",
    "            )\n",
    "        )\n",
    "\n",
    "    def forward(self, prototype_map):\n",
    "        scale = (\n",
    "            self.log_scale\n",
    "            .exp()\n",
    "            .clamp(min=1.0, max=100.0)\n",
    "        )\n",
    "\n",
    "        return (\n",
    "            self.classifier(\n",
    "                prototype_map\n",
    "            )\n",
    "            * scale\n",
    "        )\n",
    "\n",
    "\n",
    "class SourcePLADANetwork(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "\n",
    "        self.generator = ResidualFeatureGenerator(\n",
    "            FEATURE_DIM,\n",
    "            16\n",
    "        )\n",
    "\n",
    "        self.prototype_layer = PrototypeLayer(\n",
    "            NUM_CLASSES,\n",
    "            FEATURE_DIM\n",
    "        )\n",
    "\n",
    "        self.prototype_classifier = PrototypeClassifier(\n",
    "            NUM_CLASSES,\n",
    "            10.0\n",
    "        )\n"
   ]
