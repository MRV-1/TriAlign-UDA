   "source": [
    "\n",
    "# ============================================================\n",
    "# 3) Deterministic common post-hoc raw-sample subsets\n",
    "# ============================================================\n",
    "src_train_idx = load_idx(\n",
    "    TRIALIGN_RUN,\n",
    "    \"nct_source_train_indices_seed42.npy\"\n",
    ").astype(np.int64)\n",
    "\n",
    "tcga_idx = load_idx(\n",
    "    TRIALIGN_RUN,\n",
    "    \"tcga_indices_seed42_n10000.npy\"\n",
    ").astype(np.int64)\n",
    "\n",
    "rng = np.random.default_rng(AUDIT_SEED)\n",
    "\n",
    "source_eval_idx = np.sort(\n",
    "    rng.choice(\n",
    "        src_train_idx,\n",
    "        size=ALIGN_N,\n",
    "        replace=False\n",
    "    )\n",
    ")\n",
    "\n",
    "target_eval_idx = np.sort(\n",
    "    rng.choice(\n",
    "        tcga_idx,\n",
    "        size=ALIGN_N,\n",
    "        replace=False\n",
    "    )\n",
    ")\n",
    "\n",
    "# Same raw source examples for class-mean prototypes across all methods.\n",
    "proto_parts = []\n",
    "\n",
    "for c in range(NUM_CLASSES):\n",
    "    candidates = src_train_idx[\n",
    "        ys[src_train_idx] == c\n",
    "    ]\n",
    "\n",
    "    chosen = rng.choice(\n",
    "        candidates,\n",
    "        size=min(PROTO_PER_CLASS, len(candidates)),\n",
    "        replace=False\n",
    "    )\n",
    "\n",
    "    proto_parts.append(\n",
    "        np.sort(chosen)\n",
    "    )\n",
    "\n",
    "prototype_source_idx = np.concatenate(proto_parts)\n",
    "\n",
    "np.save(\n",
    "    os.path.join(AUDIT_DIR, \"source_eval_indices.npy\"),\n",
    "    source_eval_idx\n",
    ")\n",
    "\n",
    "np.save(\n",
    "    os.path.join(AUDIT_DIR, \"target_eval_indices.npy\"),\n",
    "    target_eval_idx\n",
    ")\n",
    "\n",
    "np.save(\n",
    "    os.path.join(AUDIT_DIR, \"prototype_source_indices.npy\"),\n",
    "    prototype_source_idx\n",
    ")\n",
    "\n",
    "print(\"Common source alignment N:\", len(source_eval_idx))\n",
    "print(\"Common target alignment N:\", len(target_eval_idx))\n",
    "print(\"Common prototype source N:\", len(prototype_source_idx))\n",
    "print(\"Prototype class counts:\")\n",
    "for c in range(NUM_CLASSES):\n",
