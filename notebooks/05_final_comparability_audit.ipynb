    "\n",
    "# ============================================================\n",
    "# 5) Checkpoint loaders / method wrappers — ALL METHODS\n",
    "# ============================================================\n",
    "def load_reference_method(method, seed):\n",
    "    \"\"\"\n",
    "    SourceOnly, DeepCORAL, DAN, DANN and TriAlign-UDA all come\n",
    "    from the same final reference run and use the same\n",
    "    BottleneckAdapter + LinearHead architecture.\n",
    "    \"\"\"\n",
    "    ckpt = os.path.join(\n",
    "        TRIALIGN_RUN,\n",
    "        \"checkpoints\",\n",
    "        f\"seed{seed}\",\n",
    "        method,\n",
    "        \"best_checkpoint.pt\"\n",
    "    )\n",
    "    assert os.path.exists(ckpt), ckpt\n",
    "\n",
    "    payload = torch.load(\n",
    "        ckpt,\n",
    "        map_location=DEVICE\n",
    "    )\n",
    "\n",
    "    adapter = TriAlignAdapter().to(DEVICE)\n",
    "    head = TriAlignHead().to(DEVICE)\n",
    "\n",
    "    adapter.load_state_dict(\n",
    "        payload[\"adapter\"]\n",
    "    )\n",
    "    head.load_state_dict(\n",
    "        payload[\"head\"]\n",
    "    )\n",
    "\n",
    "    adapter.eval()\n",
    "    head.eval()\n",
    "\n",
    "    display = DISPLAY_NAME[method]\n",
    "\n",
    "    return {\n",
    "        \"name\": display,\n",
    "        \"stored_method_name\": method,\n",
    "        \"latent_dim\": 1536,\n",
    "        \"source_features\": lambda x: adapter(x),\n",
    "        \"target_features\": lambda x: adapter(x),\n",
    "        \"logits\": lambda z: head(z),\n",
    "        \"objects\": (adapter, head),\n",
    "    }\n",
    "\n",
    "\n",
    "def load_euda(seed):\n",
    "    ckpt = os.path.join(\n",
    "        EUDA_RUN,\n",
    "        \"checkpoints\",\n",
    "        f\"seed{seed}\",\n",
    "        \"EUDA_UNI2H\",\n",
    "        \"best_checkpoint.pt\"\n",
    "    )\n",
    "    assert os.path.exists(ckpt), ckpt\n",
    "\n",
    "    payload = torch.load(\n",
    "        ckpt,\n",
    "        map_location=DEVICE\n",
    "    )\n",
    "\n",
    "    model = EUDASmall().to(DEVICE)\n",
    "\n",
    "    model.load_state_dict(\n",
    "        payload[\"model_state_dict\"]\n",
    "    )\n",
    "\n",
    "    model.eval()\n",
    "\n",
    "    return {\n",
    "        \"name\": \"EUDA\",\n",
    "        \"stored_method_name\": \"EUDA_UNI2H\",\n",
    "        \"latent_dim\": 256,\n",
    "        \"source_features\": lambda x: model.features(x),\n",
    "        \"target_features\": lambda x: model.features(x),\n",
    "        \"logits\": lambda z: model.logits_from_features(z),\n",
    "        \"objects\": (model,),\n",
    "    }\n",
    "\n",
    "\n",
    "def load_plada(seed):\n",
    "    source_ckpt = os.path.join(\n",
    "        PLADA_RUN,\n",
    "        \"checkpoints\",\n",
    "        \"source_stage\",\n",
    "        f\"source_best_seed{seed}.pt\"\n",
    "    )\n",
    "\n",
    "    adapt_ckpt = os.path.join(\n",
    "        PLADA_RUN,\n",
    "        \"checkpoints\",\n",
    "        \"adapt_stage\",\n",
    "        f\"adapt_best_seed{seed}.pt\"\n",
    "    )\n",
    "\n",
    "    assert os.path.exists(source_ckpt), source_ckpt\n",
    "    assert os.path.exists(adapt_ckpt), adapt_ckpt\n",
    "\n",
    "    source_payload = torch.load(\n",
    "        source_ckpt,\n",
    "        map_location=DEVICE\n",
    "    )\n",
    "\n",
    "    adapt_payload = torch.load(\n",
    "        adapt_ckpt,\n",
    "        map_location=DEVICE\n",
    "    )\n",
    "\n",
    "    source_model = SourcePLADANetwork().to(DEVICE)\n",
    "\n",
    "    source_model.load_state_dict(\n",
    "        source_payload[\"model_state_dict\"]\n",
    "    )\n",
    "\n",
    "    target_generator = ResidualFeatureGenerator(\n",
    "        FEATURE_DIM,\n",
    "        16\n",
    "    ).to(DEVICE)\n",
    "\n",
    "    target_generator.load_state_dict(\n",
    "        adapt_payload[\n",
    "            \"target_generator_state_dict\"\n",
    "        ]\n",
    "    )\n",
    "\n",
    "    source_model.eval()\n",
    "    target_generator.eval()\n",
    "\n",
    "    def plada_logits(z):\n",
    "        proto_map, _ = (\n",
    "            source_model\n",
    "            .prototype_layer(z)\n",
    "        )\n",
    "\n",
    "        return (\n",
    "            source_model\n",
    "            .prototype_classifier(\n",
    "                proto_map\n",
    "            )\n",
    "        )\n",
    "\n",
    "    return {\n",
    "        \"name\": \"PLADA-f\",\n",
    "        \"stored_method_name\": \"PLADA_f_UNI2H_v3\",\n",
    "        \"latent_dim\": 1536,\n",
    "        \"source_features\": lambda x: source_model.generator(x),\n",
    "        \"target_features\": lambda x: target_generator(x),\n",
    "        \"logits\": plada_logits,\n",
    "        \"objects\": (source_model, target_generator),\n",
    "    }\n",
    "\n",
    "\n",
    "METHOD_LOADERS = {\n",
    "    \"SourceOnly\": lambda seed: load_reference_method(\"SourceOnly\", seed),\n",
    "    \"DeepCORAL\": lambda seed: load_reference_method(\"DeepCORAL\", seed),\n",
    "    \"DAN\": lambda seed: load_reference_method(\"DAN\", seed),\n",
    "    \"DANN\": lambda seed: load_reference_method(\"DANN\", seed),\n",
    "    \"TriAlign-UDA\": lambda seed: load_reference_method(\"TriAlign_UDA\", seed),\n",
    "    \"EUDA\": load_euda,\n",
    "    \"PLADA-f\": load_plada,\n",
    "}\n"
