    "\n",
    "# ============================================================\n",
    "# 6) Common evaluation utilities\n",
    "# ============================================================\n",
    "@torch.no_grad()\n",
    "def forward_numpy(feature_fn, X, indices, batch_size=256):\n",
    "    out = []\n",
    "\n",
    "    for start in range(\n",
    "        0,\n",
    "        len(indices),\n",
    "        batch_size\n",
    "    ):\n",
    "        idx = indices[\n",
    "            start:start + batch_size\n",
    "        ]\n",
    "\n",
    "        xb = torch.from_numpy(\n",
    "            np.asarray(\n",
    "                X[idx],\n",
    "                dtype=np.float32\n",
    "            ).copy()\n",
    "        ).to(DEVICE)\n",
    "\n",
    "        z = feature_fn(xb)\n",
    "\n",
    "        out.append(\n",
    "            z.detach().cpu()\n",
    "        )\n",
    "\n",
    "    return torch.cat(\n",
    "        out,\n",
    "        dim=0\n",
    "    )\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def external_metrics(method_obj):\n",
    "    ys_true = []\n",
    "    ys_pred = []\n",
    "\n",
    "    all_idx = np.arange(\n",
    "        len(ycrc),\n",
    "        dtype=np.int64\n",
    "    )\n",
    "\n",
    "    for start in range(\n",
    "        0,\n",
    "        len(all_idx),\n",
    "        256\n",
    "    ):\n",
    "        idx = all_idx[\n",
    "            start:start + 256\n",
    "        ]\n",
    "\n",
    "        xb = torch.from_numpy(\n",
    "            np.asarray(\n",
    "                Xcrc[idx],\n",
    "                dtype=np.float32\n",
    "            ).copy()\n",
    "        ).to(DEVICE)\n",
    "\n",
    "        z = method_obj[\n",
    "            \"target_features\"\n",
    "        ](xb)\n",
    "\n",
    "        logits = method_obj[\n",
    "            \"logits\"\n",
    "        ](z)\n",
    "\n",
    "        pred = (\n",
    "            logits.argmax(1)\n",
    "            .cpu()\n",
    "            .numpy()\n",
    "        )\n",
    "\n",
    "        ys_pred.append(pred)\n",
    "        ys_true.append(\n",
    "            ycrc[idx]\n",
    "        )\n",
    "\n",
    "    yt = np.concatenate(\n",
    "        ys_true\n",
    "    )\n",
    "\n",
    "    yp = np.concatenate(\n",
    "        ys_pred\n",
    "    )\n",
    "\n",
    "    return {\n",
    "        \"Accuracy\": float(\n",
    "            accuracy_score(\n",
    "                yt,\n",
    "                yp\n",
    "            )\n",
    "        ),\n",
    "\n",
    "        \"Balanced_Accuracy\": float(\n",
    "            balanced_accuracy_score(\n",
    "                yt,\n",
    "                yp\n",
    "            )\n",
    "        ),\n",
    "\n",
    "        \"Macro_F1\": float(\n",
    "            f1_score(\n",
    "                yt,\n",
    "                yp,\n",
    "                average=\"macro\"\n",
    "            )\n",
    "        ),\n",
    "    }\n",
    "\n",
    "\n",
    "def coral_value(fs, ft):\n",
    "    fs = fs.to(\n",
    "        dtype=torch.float32\n",
    "    )\n",
    "\n",
    "    ft = ft.to(\n",
    "        dtype=torch.float32\n",
    "    )\n",
    "\n",
    "    fs0 = (\n",
    "        fs\n",
    "        - fs.mean(\n",
    "            0,\n",
    "            keepdim=True\n",
    "        )\n",
    "    )\n",
    "\n",
    "    ft0 = (\n",