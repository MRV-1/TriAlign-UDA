    "\n",
    "# ============================================================\n",
    "# 3) Data — exact TriAlign source split / exact TCGA target subset\n",
    "# ============================================================\n",
    "def set_seed(seed):\n",
    "    random.seed(seed)\n",
    "    np.random.seed(seed)\n",
    "\n",
    "    torch.manual_seed(seed)\n",
    "    torch.cuda.manual_seed_all(seed)\n",
    "\n",
    "    torch.backends.cudnn.benchmark = False\n",
    "    torch.backends.cudnn.deterministic = True\n",
    "\n",
    "\n",
    "class CachedFeatureDataset(Dataset):\n",
    "    def __init__(self, X, y=None, indices=None):\n",
    "        self.X = X\n",
    "        self.y = y\n",
    "        self.indices = (\n",
    "            np.asarray(indices, dtype=np.int64)\n",
    "            if indices is not None\n",
    "            else None\n",
    "        )\n",
    "\n",
    "    def __len__(self):\n",
    "        return (\n",
    "            len(self.indices)\n",
    "            if self.indices is not None\n",
    "            else len(self.X)\n",
    "        )\n",
    "\n",
    "    def __getitem__(self, i):\n",
    "        j = (\n",
    "            int(self.indices[i])\n",
    "            if self.indices is not None\n",
    "            else i\n",
    "        )\n",
    "\n",
    "        x = torch.from_numpy(\n",
    "            np.asarray(\n",
    "                self.X[j],\n",
    "                dtype=np.float32\n",
    "            ).copy()\n",
    "        )\n",
    "\n",
    "        if self.y is None:\n",
    "            return x\n",
    "\n",
    "        return x, int(self.y[j])\n",
    "\n",
    "\n",
    "def ref_config_file(filename):\n",
    "    p = os.path.join(\n",
    "        REFERENCE_TRIALIGN_RUN,\n",
    "        \"config\",\n",
    "        filename\n",
    "    )\n",
    "\n",
    "    return p if os.path.exists(p) else None\n",
    "\n",
    "\n",
    "def prepare_data():\n",
    "    print(\"Loading frozen UNI2-H feature banks...\")\n",
    "\n",
    "    Xs = np.load(NCT_X_PATH, mmap_mode=\"r\")\n",
    "    ys = np.load(NCT_Y_PATH)\n",
    "\n",
    "    Xext = np.load(CRC_X_PATH, mmap_mode=\"r\")\n",
    "    yext = np.load(CRC_Y_PATH)\n",
    "\n",
    "    Xt = np.load(TCGA_X_PATH, mmap_mode=\"r\")\n",
    "\n",
    "    class_names = np.load(\n",
    "        CLASS_NAMES_PATH,\n",
    "        allow_pickle=True\n",
    "    ).tolist()\n",
    "\n",
    "    ref_train = ref_config_file(\n",
    "        f\"nct_source_train_indices_seed{SOURCE_SPLIT_SEED}.npy\"\n",
    "    )\n",
    "\n",
    "    ref_val = ref_config_file(\n",
    "        f\"nct_source_val_indices_seed{SOURCE_SPLIT_SEED}.npy\"\n",
    "    )\n",
    "\n",
    "    ref_target = ref_config_file(\n",
    "        f\"tcga_indices_seed{TCGA_DATA_SEED}_n{min(TCGA_TARGET_N, len(Xt))}.npy\"\n",
    "    )\n",
    "\n",
    "    if ref_train and ref_val:\n",
    "        src_train_idx = np.load(ref_train)\n",
    "        src_val_idx = np.load(ref_val)\n",
    "\n",
    "        source_split_origin = \"reference_run_exact_indices\"\n",
    "\n",
    "    else:\n",
    "        all_idx = np.arange(len(ys))\n",
    "\n",
    "        src_train_idx, src_val_idx = train_test_split(\n",
    "            all_idx,\n",
    "            test_size=SOURCE_VAL_SIZE,\n",
    "            random_state=SOURCE_SPLIT_SEED,\n",
    "            stratify=ys\n",
    "        )\n",
    "\n",
    "        source_split_origin = \"reproduced_seed42_rule\"\n",
    "\n",
    "    if ref_target:\n",
    "        tcga_idx = np.load(ref_target)\n",
    "        target_subset_origin = \"reference_run_exact_indices\"\n",
    "\n",
    "    else:\n",
    "        rng = np.random.default_rng(TCGA_DATA_SEED)\n",
    "\n",
    "        tcga_idx = np.sort(\n",
    "            rng.choice(\n",
    "                len(Xt),\n",
    "                size=min(TCGA_TARGET_N, len(Xt)),\n",
    "                replace=False\n",
    "            )\n",
    "        )\n",
    "\n",
    "        target_subset_origin = \"reproduced_seed42_rule\"\n",
    "\n",
    "    src_train_idx = np.asarray(src_train_idx, dtype=np.int64)\n",
