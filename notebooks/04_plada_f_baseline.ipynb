    "\n",
    "# ============================================================\n",
    "# 4) PLADA-f components\n",
    "# ============================================================\n",
    "class ResidualFeatureGenerator(nn.Module):\n",
    "    \"\"\"\n",
    "    Feature-level generator on top of frozen UNI2-H pooled features.\n",
    "    Shape remains 1536-D so alignment metrics remain comparable with\n",
    "    the existing TriAlign feature-level protocol.\n",
    "    \"\"\"\n",
    "    def __init__(self, dim=1536, reduction=16):\n",
    "        super().__init__()\n",
    "\n",
    "        hidden = max(dim // reduction, 64)\n",
    "\n",
    "        self.norm = nn.LayerNorm(dim)\n",
    "\n",
    "        self.fc1 = nn.Linear(\n",
    "            dim,\n",
    "            hidden\n",
    "        )\n",
    "\n",
    "        self.fc2 = nn.Linear(\n",
    "            hidden,\n",
    "            dim\n",
    "        )\n",
    "\n",
    "        # Exact identity initialization.\n",
    "        nn.init.zeros_(self.fc2.weight)\n",
    "        nn.init.zeros_(self.fc2.bias)\n",
    "\n",
    "    def forward(self, x):\n",
    "        delta = self.fc2(\n",
    "            F.gelu(\n",
    "                self.fc1(\n",
    "                    self.norm(x)\n",
    "                )\n",
    "            )\n",
    "        )\n",
    "\n",
    "        return x + delta\n",
    "\n",
    "\n",
    "class PrototypeLayer(nn.Module):\n",
    "    \"\"\"\n",
    "    Trainable source category prototypes.\n",
    "\n",
    "    Prototype mapping feature = cosine similarities to all prototypes.\n",
    "    Distance used by WPL = normalized squared Euclidean distance,\n",
    "    d^2 = 2 - 2*cosine_similarity.\n",
    "    \"\"\"\n",
    "    def __init__(self, num_classes=9, dim=1536):\n",
    "        super().__init__()\n",
    "\n",
    "        self.prototypes = nn.Parameter(\n",
    "            torch.empty(\n",
    "                num_classes,\n",
    "                dim\n",
    "            )\n",
    "        )\n",
    "\n",
    "        nn.init.normal_(\n",
    "            self.prototypes,\n",
    "            mean=0.0,\n",
    "            std=0.02\n",
    "        )\n",
    "\n",
    "    def forward(self, z):\n",
    "        zn = F.normalize(\n",
    "            z,\n",
    "            dim=1\n",
    "        )\n",
    "\n",
    "        pn = F.normalize(\n",
    "            self.prototypes,\n",
    "            dim=1\n",
    "        )\n",
    "\n",
    "        similarity = zn.matmul(\n",
    "            pn.t()\n",
    "        )\n",
    "\n",
    "        distance_sq = (\n",
    "            2.0\n",
    "            - 2.0 * similarity\n",
    "        ).clamp_min(0.0)\n",
    "\n",
    "        return similarity, distance_sq\n",
    "\n",
    "\n",
    "class PrototypeClassifier(nn.Module):\n",
    "    \"\"\"\n",
    "    Shared classifier operating on prototype-mapping features.\n",
    "    \"\"\"\n",
    "    def __init__(self, num_classes=9, scale_init=10.0):\n",
    "        super().__init__()\n",
    "\n",
    "        self.classifier = nn.Linear(\n",
    "            num_classes,\n",
    "            num_classes\n",
    "        )\n",
    "\n",
    "        # Start close to direct prototype-similarity classification.\n",
    "        with torch.no_grad():\n",
    "            self.classifier.weight.zero_()\n",
    "            self.classifier.bias.zero_()\n",
    "\n",
    "            self.classifier.weight.copy_(\n",
    "                torch.eye(num_classes)\n",
    "            )\n",
    "\n",
    "        self.log_scale = nn.Parameter(\n",
    "            torch.tensor(\n",
    "                math.log(scale_init),\n",
    "                dtype=torch.float32\n",
    "            )\n",
    "        )\n",
    "\n",
    "    def forward(self, prototype_map):\n",
    "        scale = (\n",
    "            self.log_scale\n",
    "            .exp()\n",
    "            .clamp(\n",
    "                min=1.0,\n",
    "                max=100.0\n",
    "            )\n",
    "        )\n",
    "\n",
    "        return (\n",
    "            self.classifier(\n",
    "                prototype_map\n",
    "            )\n",
    "            * scale\n",
    "        )\n",
    "\n",
    "\n",
    "class SourcePLADANetwork(nn.Module):\n",
    "    def __init__(self):\n",
    "        super().__init__()\n",
    "\n",
    "        self.generator = ResidualFeatureGenerator(\n",
    "            FEATURE_DIM,\n",
    "            ADAPTER_REDUCTION\n",
    "        )\n",
    "\n",
    "        self.prototype_layer = PrototypeLayer(\n",
    "            NUM_CLASSES,\n",
    "            FEATURE_DIM\n",
    "        )\n",
    "\n",
    "        self.prototype_classifier = PrototypeClassifier(\n",
    "            NUM_CLASSES,\n",
    "            PROTOTYPE_LOGIT_SCALE_INIT\n",
    "        )\n",
    "\n",
    "    def features(self, x):\n",
    "        return self.generator(x)\n",
    "\n",
    "    def forward(self, x):\n",
    "        z = self.features(x)\n",
    "\n",
    "        proto_map, distance_sq = (\n",
    "            self.prototype_layer(z)\n",
    "        )\n",
    "\n",
    "        logits = (\n",
    "            self.prototype_classifier(\n",
    "                proto_map\n",
    "            )\n",
    "        )\n",
    "\n",
    "        return (\n",
    "            logits,\n",
    "            z,\n",
    "            proto_map,\n",
    "            distance_sq\n",
    "        )\n",
    "\n",
    "\n",
    "class DomainDiscriminator(nn.Module):\n",
    "    def __init__(self, dim=1536):\n",
    "        super().__init__()\n",
    "\n",
    "        self.net = nn.Sequential(\n",
    "            nn.Linear(dim, 512),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Dropout(0.5),\n",
    "\n",
    "            nn.Linear(512, 256),\n",
    "            nn.ReLU(inplace=True),\n",
    "            nn.Dropout(0.5),\n",
    "\n",
    "            nn.Linear(256, 2),\n",
    "        )\n",
    "\n",
    "    def forward(self, z):\n",
    "        return self.net(z)\n",
    "\n",
    "\n",
    "@torch.no_grad()\n",
    "def initialize_prototypes_from_source_means(\n",
    "    source_model,\n",
    "    loader\n",
    "):\n",
    "    \"\"\"\n",
    "    Initialization only.\n",
    "    Unlike v2, prototypes are NOT left as fixed means:\n",
    "    Stage A subsequently learns source generator + prototypes + classifier.\n",
    "    \"\"\"\n",
    "    sums = torch.zeros(\n",
    "        NUM_CLASSES,\n",
    "        FEATURE_DIM,\n",
    "        device=device\n",
    "    )\n",
    "\n",
    "    counts = torch.zeros(\n",
    "        NUM_CLASSES,\n",
    "        device=device\n",
    "    )\n",
    "\n",
    "    source_model.generator.eval()\n",
    "\n",
    "    for x, y in tqdm(\n",
    "        loader,\n",
    "        desc=\"Prototype init\",\n",
    "        leave=False,\n",
    "        dynamic_ncols=True\n",
    "    ):\n",
    "        x = x.to(device)\n",
    "        y = y.to(device)\n",
    "\n",
    "        z = source_model.generator(x)\n",
    "\n",
    "        for c in y.unique():\n",
    "            m = (y == c)\n",
    "\n",
    "            sums[int(c)] += (\n",
    "                z[m].sum(0)\n",
    "            )\n",
    "\n",
    "            counts[int(c)] += (\n",
    "                m.sum()\n",
    "            )\n",
    "\n",
    "    means = (\n",
    "        sums\n",
    "        / counts.unsqueeze(1).clamp_min(1.0)\n",
    "    )\n",
    "\n",
    "    source_model.prototype_layer.prototypes.copy_(\n",
    "        means\n",
    "    )\n",
    "\n",
    "\n",
    "def count_trainable_params(module):\n",
    "    return int(\n",
    "        sum(\n",
    "            p.numel()\n",
    "            for p in module.parameters()\n",
    "            if p.requires_grad\n",
    "        )\n",
    "    )\n",
    "\n",
    "\n",
    "def freeze_module(module):\n",
    "    module.eval()\n",
    "\n",
    "    for p in module.parameters():\n",
    "        p.requires_grad = False\n"
   ]
