    "\n",
    "# ============================================================\n",
    "# 5) EUDA on frozen UNI2-H feature banks\n",
    "# ============================================================\n",
    "class EUDASmall(nn.Module):\n",
    "    \"\"\"\n",
    "    Common-backbone reimplementation of EUDA-small:\n",
    "        frozen UNI2-H pooled feature (1536)\n",
    "        -> Linear bottleneck (256)\n",
    "        -> Linear classifier (9)\n",
    "    No encoder parameter exists in this model.\n",
    "    \"\"\"\n",
    "    def __init__(self, input_dim=1536, bottleneck_dim=256, num_classes=9):\n",
    "        super().__init__()\n",
    "        self.bottleneck = nn.Linear(input_dim, bottleneck_dim)\n",
    "        self.head = nn.Linear(bottleneck_dim, num_classes)\n",
    "\n",
    "    def features(self, x):\n",
    "        return self.bottleneck(x)\n",
    "\n",
    "    def logits_from_features(self, z):\n",
    "        return self.head(z)\n",
    "\n",
    "    def forward(self, x):\n",
    "        z = self.features(x)\n",
    "        return z, self.head(z)\n",
    "\n",
    "def count_trainable_params(model):\n",
    "    return int(sum(p.numel() for p in model.parameters() if p.requires_grad))\n",
    "\n",
    "def euda_ckpt_dir(seed):\n",
    "    return ensure_dir(os.path.join(CKPT_DIR, f\"seed{seed}\", EUDA_METHOD_NAME))\n",
    "\n",
    "def train_euda_one_seed(seed):\n",
    "    set_seed(seed)\n",
    "    loaders = make_loaders(seed)\n",
    "\n",
    "    model = EUDASmall(FEATURE_DIM, EUDA_BOTTLENECK, NUM_CLASSES).to(device)\n",
    "    params = [p for p in model.parameters() if p.requires_grad]\n",
    "    opt = torch.optim.AdamW(params, lr=LR, weight_decay=WEIGHT_DECAY)\n",
    "    scaler = torch.cuda.amp.GradScaler(enabled=(USE_AMP and torch.cuda.is_available()))\n",
    "\n",
    "    best_f1 = -np.inf\n",
    "    best_epoch = None\n",
    "    best_path = os.path.join(euda_ckpt_dir(seed), \"best_checkpoint.pt\")\n",
    "    logs = []\n",
    "    tgt_cycle = cycle(loaders[\"target\"])\n",
    "    t0 = time.time()\n",
    "\n",
    "    append_jsonl(EVENT_LOG, {\n",
    "        \"event\": \"method_start\", \"method\": EUDA_METHOD_NAME,\n",
    "        \"seed\": seed, \"timestamp\": datetime.now().isoformat()\n",
    "    })\n",
    "\n",
    "    for epoch in range(1, EPOCHS + 1):\n",
    "        model.train()\n",
    "        loss_total_list, ce_list, mmd_list = [], [], []\n",
    "\n",
    "        pbar = tqdm(\n",
    "            loaders[\"src_train\"],\n",
    "            desc=f\"{EUDA_METHOD_NAME} seed={seed} epoch={epoch}/{EPOCHS}\",\n",
    "            leave=False, dynamic_ncols=True\n",
    "        )\n",
    "\n",
    "        for xs, ys in pbar:\n",
    "            xt = next(tgt_cycle)\n",
    "            xs, ys, xt = xs.to(device), ys.to(device), xt.to(device)\n",
    "            opt.zero_grad(set_to_none=True)\n",
    "\n",
    "            with torch.cuda.amp.autocast(\n",
    "                enabled=(USE_AMP and torch.cuda.is_available())\n",
    "            ):\n",
    "                fs, logits_s = model(xs)\n",
    "                ft = model.features(xt)\n",
    "\n",
    "                ce = F.cross_entropy(logits_s, ys)\n",
    "                mmd = mkmmd_loss(fs, ft)\n",
    "                loss = EUDA_LAMBDA_CE * ce + EUDA_LAMBDA_MMD * mmd\n",
    "\n",
    "            if not torch.isfinite(loss):\n",
    "                continue\n",
    "\n",
    "            scaler.scale(loss).backward()\n",
    "            if GRAD_CLIP_NORM:\n",
    "                scaler.unscale_(opt)\n",
    "                torch.nn.utils.clip_grad_norm_(params, GRAD_CLIP_NORM)\n",
    "            scaler.step(opt)\n",
    "            scaler.update()\n",
    "\n",
    "            loss_total_list.append(float(loss.detach().item()))\n",
    "            ce_list.append(float(ce.detach().item()))\n",
    "            mmd_list.append(float(mmd.detach().item()))\n",
    "\n",
    "        # IMPORTANT: only internal NCT validation is computed during training.\n",
    "        model.eval()\n",
    "        val_metrics, _, _ = eval_classifier(\n",
    "            model.features, model.logits_from_features,\n",
    "            loaders[\"src_val\"], \"NCTval\"\n",
    "        )\n",
    "\n",
    "        row = {\n",
    "            \"method\": EUDA_METHOD_NAME,\n",
    "            \"seed\": seed,\n",
    "            \"epoch\": epoch,\n",
    "            \"loss\": float(np.mean(loss_total_list)),\n",
    "            \"loss_ce\": float(np.mean(ce_list)),\n",
    "            \"loss_mmd\": float(np.mean(mmd_list)),\n",
    "            **val_metrics,\n",
    "            \"external_evaluated_this_epoch\": False,\n",
    "        }\n",
    "        logs.append(row)\n",
    "\n",
    "        if val_metrics[\"NCTval_macroF1\"] > best_f1:\n",
    "            best_f1 = val_metrics[\"NCTval_macroF1\"]\n",
    "            best_epoch = epoch\n",
    "            torch.save({\n",
    "                \"model_state_dict\": model.state_dict(),\n",
    "                \"optimizer_state_dict\": opt.state_dict(),\n",
    "                \"method\": EUDA_METHOD_NAME,\n",
    "                \"seed\": seed,\n",
    "                \"epoch\": epoch,\n",
    "                \"best_NCTval_macroF1\": float(best_f1),\n",
    "                \"method_config\": {\n",
    "                    \"input_dim\": FEATURE_DIM,\n",
    "                    \"bottleneck_dim\": EUDA_BOTTLENECK,\n",
    "                    \"num_classes\": NUM_CLASSES,\n",
    "                    \"lambda_ce\": EUDA_LAMBDA_CE,\n",
    "                    \"lambda_mmd\": EUDA_LAMBDA_MMD,\n",
    "                    \"mmd_impl\": \"TriAlign audited five-RBF MK-MMD estimator\",\n",
    "                },\n",
    "                \"run_config\": CONFIG,\n",
    "                \"data_manifest\": DATA_MANIFEST,\n",
    "            }, best_path)\n",
    "\n",
    "        print(\n",
    "            f\"[{EUDA_METHOD_NAME} seed={seed} epoch={epoch}] \"\n",
    "            f\"NCTval_F1={val_metrics['NCTval_macroF1']:.6f} \"\n",
    "            f\"loss={row['loss']:.6f} CE={row['loss_ce']:.6f} MMD={row['loss_mmd']:.6f}\"\n",
    "        )\n",
    "\n",
    "    # Load best NCT-validation checkpoint BEFORE external evaluation.\n",
    "    payload = torch.load(best_path, map_location=device)\n",
    "    model.load_state_dict(payload[\"model_state_dict\"])\n",
    "    model.eval()\n",
    "\n",
    "    final = final_evaluate(\n",
    "        model.features, model.logits_from_features,\n",
    "        loaders, EUDA_BOTTLENECK, EUDA_METHOD_NAME, seed\n",
    "    )\n",
    "\n",
    "    elapsed_sec = time.time() - t0\n",
    "    final.update({\n",
    "        \"method\": EUDA_METHOD_NAME,\n",
    "        \"seed\": seed,\n",
    "        \"best_epoch\": int(best_epoch),\n",
    "        \"best_NCTval_macroF1\": float(best_f1),\n",
    "        \"trainable_params\": count_trainable_params(model),\n",
    "        \"training_time_sec\": float(elapsed_sec),\n",
    "        \"training_time_min\": float(elapsed_sec / 60.0),\n",
    "        \"manuscript_ready\": True,\n",
    "        \"backbone\": \"UNI2-H frozen\",\n",
    "        \"target_labels_used\": False,\n",
    "        \"external_used_for_selection\": False,\n",
    "    })\n",
    "\n",
    "    log_df = pd.DataFrame(logs)\n",
    "    save_df(\n",
    "        log_df,\n",
    "        os.path.join(LOG_DIR, f\"epoch_logs_{EUDA_METHOD_NAME}_seed{seed}.csv\"),\n",
    "        os.path.join(LOG_DIR, f\"epoch_logs_{EUDA_METHOD_NAME}_seed{seed}.xlsx\")\n",
    "    )\n",
    "    save_df(\n",
    "        pd.DataFrame([final]),\n",
    "        os.path.join(TABLE_DIR, f\"final_result_{EUDA_METHOD_NAME}_seed{seed}.csv\"),\n",
    "        os.path.join(TABLE_DIR, f\"final_result_{EUDA_METHOD_NAME}_seed{seed}.xlsx\")\n",
    "    )\n",
    "    save_json({\n",
    "        \"status\": \"COMPLETED\",\n",
    "        \"method\": EUDA_METHOD_NAME,\n",
    "        \"seed\": seed,\n",
    "        \"best_epoch\": best_epoch,\n",
    "        \"best_NCTval_macroF1\": best_f1,\n",
    "        \"checkpoint\": best_path,\n",
    "        \"final\": final,\n",
    "    }, os.path.join(STATUS_DIR, f\"{EUDA_METHOD_NAME}_seed{seed}.json\"))\n",
    "\n",
    "    append_jsonl(EVENT_LOG, {\n",
    "        \"event\": \"method_end\", \"method\": EUDA_METHOD_NAME,\n",
    "        \"seed\": seed, \"timestamp\": datetime.now().isoformat(),\n",
    "        \"best_epoch\": best_epoch, \"best_NCTval_macroF1\": best_f1,\n",
    "        \"training_time_sec\": elapsed_sec\n",
    "    })\n",
    "    return final, log_df\n"
   ]
