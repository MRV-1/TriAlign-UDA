    "\n",
    "# ============================================================\n",
    "# 3) Data loading — exact TriAlign split reuse when available\n",
    "# ============================================================\n",
    "def set_seed(seed):\n",
    "    random.seed(seed)\n",
    "    np.random.seed(seed)\n",
    "    torch.manual_seed(seed)\n",
    "    torch.cuda.manual_seed_all(seed)\n",
    "    torch.backends.cudnn.benchmark = False\n",
    "    torch.backends.cudnn.deterministic = True\n",
    "\n",
    "class CachedFeatureDataset(Dataset):\n",
    "    def __init__(self, X, y=None, indices=None):\n",
    "        self.X = X\n",
    "        self.y = y\n",
    "        self.indices = np.asarray(indices) if indices is not None else None\n",
    "    def __len__(self):\n",
    "        return len(self.indices) if self.indices is not None else len(self.X)\n",
    "    def __getitem__(self, i):\n",
    "        j = int(self.indices[i]) if self.indices is not None else i\n",
    "        x = torch.from_numpy(np.asarray(self.X[j], dtype=np.float32).copy())\n",
    "        if self.y is None:\n",
    "            return x\n",
    "        return x, int(self.y[j])\n",
    "\n",
    "def _reference_index_path(filename):\n",
    "    p = os.path.join(REFERENCE_TRIALIGN_RUN, \"config\", filename)\n",
    "    return p if os.path.exists(p) else None\n",
    "\n",
    "def prepare_data():\n",
    "    Xs = np.load(NCT_X_PATH, mmap_mode=\"r\")\n",
    "    ys = np.load(NCT_Y_PATH)\n",
    "    Xext = np.load(CRC_X_PATH, mmap_mode=\"r\")\n",
    "    yext = np.load(CRC_Y_PATH)\n",
    "    Xt = np.load(TCGA_X_PATH, mmap_mode=\"r\")\n",
    "    class_names = np.load(CLASS_NAMES_PATH, allow_pickle=True).tolist()\n",
    "\n",
    "    # Prefer the exact index arrays from the accepted/reference TriAlign run.\n",
    "    ref_train = _reference_index_path(f\"nct_source_train_indices_seed{SOURCE_SPLIT_SEED}.npy\")\n",
    "    ref_val = _reference_index_path(f\"nct_source_val_indices_seed{SOURCE_SPLIT_SEED}.npy\")\n",
    "    ref_tgt = _reference_index_path(f\"tcga_indices_seed{TCGA_DATA_SEED}_n{min(TCGA_TARGET_N, len(Xt))}.npy\")\n",
    "\n",
    "    if ref_train and ref_val:\n",
    "        src_train_idx = np.load(ref_train)\n",
    "        src_val_idx = np.load(ref_val)\n",
    "        source_split_origin = \"reference_run_exact_indices\"\n",
    "    else:\n",
    "        all_src_idx = np.arange(len(ys))\n",
    "        src_train_idx, src_val_idx = train_test_split(\n",
    "            all_src_idx,\n",
    "            test_size=SOURCE_VAL_SIZE,\n",
    "            random_state=SOURCE_SPLIT_SEED,\n",
    "            stratify=ys\n",
    "        )\n",
    "        src_train_idx = np.asarray(src_train_idx)\n",
    "        src_val_idx = np.asarray(src_val_idx)\n",
